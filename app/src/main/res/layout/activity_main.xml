<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not connected"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <!-- ===== SCAN SECTION ===== -->
    <LinearLayout
        android:id="@+id/scanSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan for paired Bluetooth devices" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- ===== MODE TOGGLE (hidden until connected) ===== -->
    <LinearLayout
        android:id="@+id/modeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/showExplorerBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Explorer" />

        <Button
            android:id="@+id/showDashboardBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dashboard" />

        <Button
            android:id="@+id/disconnectBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disconnect" />
    </LinearLayout>

    <!-- ===== EXPLORER SECTION ===== -->
    <LinearLayout
        android:id="@+id/explorerSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap a characteristic to read/subscribe. Watch which one changes when the case lid opens/closes or you check battery in the Realme app."
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/characteristicList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- ===== DASHBOARD SECTION ===== -->
    <ScrollView
        android:id="@+id/dashboardSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Left bud"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/leftBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/leftLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- %" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Right bud"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/rightBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/rightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- %" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Case"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/caseBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/caseLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- %" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mapping config (from Explorer)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Characteristic UUID:" />
            <EditText
                android:id="@+id/uuidInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 0000fee7-0000-1000-8000-00805f9b34fb"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Left byte #" />
                    <EditText android:id="@+id/leftByteInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Right byte #" />
                    <EditText android:id="@+id/rightByteInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Case byte #" />
                    <EditText android:id="@+id/caseByteInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/saveMappingBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Save mapping and subscribe" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
